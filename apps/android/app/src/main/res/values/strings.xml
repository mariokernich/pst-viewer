    <string name="help_title">Search Syntax</string>
    <string name="help_intro">Combine search terms and operators freely. All terms must match. Case and accents are ignored.</string>
    <string name="help_try">Tap an example to try it.</string>
    <string-array name="help_examples" tools:ignore="TypographyDashes">
        <item>invoice 2024</item>
        <item>\"kind regards\"</item>
        <item>offer OR quote</item>
        <item>-newsletter</item>
        <item>from:anna</item>
        <item>to:bob</item>
        <item>subject:vacation</item>
        <item>body:contract</item>
        <item>attachment:pdf</item>
        <item>has:attachment</item>
        <item>is:unread</item>
        <item>after:2024-03-01 before:2024-06</item>
        <item>larger:5mb</item>
        <item>type:appointment</item>
        <item>folder:archive</item>
    </string-array>
    <string-array name="help_descriptions" tools:ignore="TypographyDashes">
        <item>All terms must match</item>
        <item>Exact phrase</item>
        <item>Either term</item>
        <item>Exclude a term</item>
        <item>Sender (name or address)</item>
        <item>Recipients (To, Cc, Bcc)</item>
        <item>Subject only</item>
