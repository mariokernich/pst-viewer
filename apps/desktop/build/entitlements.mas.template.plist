<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of the Mac App Store build. scripts/dist-mas.cjs writes
  build/entitlements.mas.plist from this template with APPLE_TEAM_ID.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Must match the provisioning profile (build/embedded.provisionprofile). -->
	<key>com.apple.application-identifier</key>
	<string>__TEAM_ID__.de.kernich.pstviewer</string>
	<key>com.apple.developer.team-identifier</key>
	<string>__TEAM_ID__</string>
	<!-- Chromium's inter-process communication inside the sandbox. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>__TEAM_ID__.de.kernich.pstviewer</string>
	</array>
	<!-- Archives the user opens (only ever read) and files the user saves (exports, attachments). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Reopening recent files. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Remote images, only after the user allowed them for a message. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
