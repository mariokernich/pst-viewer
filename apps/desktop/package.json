{
  "name": "@pst-viewer/desktop",
  "productName": "PST Viewer",
  "desktopName": "pst-viewer.desktop",
  "version": "1.0.0",
  "description": "A fast, read-only viewer for Outlook data files (.pst).",
  "author": "Mario Kernich <mario@kernich.de>",
  "license": "MIT",
  "homepage": "https://mariokernich.github.io/pst-viewer/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mariokernich/pst-viewer.git",
    "directory": "apps/desktop"
  },
  "bugs": "https://github.com/mariokernich/pst-viewer/issues",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "pnpm run build && electron-builder",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "dist:mas": "pnpm run build && node scripts/dist-mas.cjs",
    "dist:appx": "pnpm run build && node scripts/dist-appx.cjs",
    "store-assets": "electron scripts/render-store-assets.cjs",
    "icons": "electron scripts/render-icon.cjs"
  },
  "dependencies": {
    "@kenjiuno/decompressrtf": "^0.1.4",
    "@kenjiuno/msgreader": "^1.28.0",
    "iconv-lite": "^0.7.3",
    "long": "^5.3.2",
    "nodemailer": "^10.0.15",
    "pst-extractor": "^1.12.0",
    "rtf-stream-parser": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cfb": "^1.2.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "entities": "^8.1.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.52.0",
    "playwright-core": "^1.63.0",
    "postal-mime": "^4.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "^4.1.0",
    "zustand": "^5.0.15"
  }
}
