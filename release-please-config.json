{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": false,
  "initial-version": "1.0.0",
  "packages": {
    ".": {
      "package-name": "pst-viewer",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/desktop/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/web/package.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "Cargo.toml" },
        { "type": "generic", "path": "apps/android/app/build.gradle.kts" },
        { "type": "generic", "path": "apps/ios/Version.xcconfig" }
      ]
    }
  }
}
